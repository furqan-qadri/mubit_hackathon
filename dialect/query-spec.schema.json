{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dialect query interpretation v1",
  "oneOf": [
    { "$ref": "#/$defs/query" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "filter", "period", "group_by", "plan", "country"],
      "properties": {
        "metric": {
          "enum": ["count_customers", "net_revenue", "gross_revenue", "refund_amount", "avg_revenue_per_customer", "login_count"]
        },
        "filter": { "enum": ["active", "churned", "trial", null] },
        "period": {
          "type": "string",
          "pattern": "^(today|this_week|last_week|this_month|last_month|this_quarter|last_quarter|this_year|last_year|[0-9]{4}-(0[1-9]|1[0-2])|[0-9]{4}-Q[1-4])$"
        },
        "group_by": { "enum": ["plan", "country", "signup_month", null] },
        "plan": { "enum": ["Starter", "Team", "Business", null] },
        "country": { "enum": ["GB", "US", "DE", "FR", "CA", "AU", null] }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error"],
      "properties": {
        "error": { "enum": ["needs_clarification", "unsupported"] }
      }
    }
  }
}
